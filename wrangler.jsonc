{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md-editor-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rawdoc.app", "custom_domain": true }],
  "vars": {
    "BETTER_AUTH_URL": "https://rawdoc.app",
    "DEV_AUTH_EMAIL": ""
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/pub/*", "/v1/*", "/p/*", "/welcome", "/", "/ws/*", "/login"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "md-editor-db", "database_id": "073462f8-7a95-4b0f-8d32-4b07f8c4448e", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "md-editor-attachments" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["0 18 * * *"] }
}
