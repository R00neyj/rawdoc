{
  "name": "rawdoc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:spike": "vite --config spike/vite.config.js",
    "build": "vite build",
    "build:spike": "vite build --config spike/vite.config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs --e2e",
    "e2e:one": "node scripts/e2e-one.mjs",
    "measure": "node scripts/measure.mjs",
    "review": "node scripts/review-diff.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "typecheck:worker": "tsc -p worker --noEmit",
    "dev:worker": "npm run build && wrangler dev --port 8790"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@kfonts/d2coding": "^0.2.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@material-symbols/svg-400": "^0.47.2",
    "fflate": "^0.8.3",
    "github-markdown-css": "^5.9.0",
    "idb": "^8.0.3",
    "markdown-it": "^15.0.2",
    "pretendard": "^1.3.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
